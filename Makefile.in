LIBNAME = basecl
DIRS    = src

PWD  = $(shell pwd)
OBJ  = obj
LIB  = @libdir@
AR   = ar
RANLIB = ranlib
prefix      = @prefix@
exec_prefix = @exec_prefix@

all debug:
	@for I in $(DIRS); do cd $(PWD)/$$I; @MAKE@ -f ../Makefile.each $@ || exit 1; cd $(PWD); done
	-@mkdir -p $(OBJ)
	-@rm -f $(LIB)/lib$(LIBNAME).a
	$(AR) rc $(LIB)/lib$(LIBNAME).a $(OBJ)/*.o
	$(RANLIB) $(LIB)/lib$(LIBNAME).a

check:
	@GCC@ -std=c++11 -I. -Isrc @CPPFLAGS@ \
	  $(shell pkg-config --cflags --libs cppunit) \
	  -o tests/run_tests \
	  tests/main.cpp tests/string_test.cpp src/string.cpp
	./tests/run_tests

clean: cleanup all

cleanup:
	-@rm -f $(OBJ)/*.o
	-@rm -f tests/run_tests
