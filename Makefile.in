LIBNAME = basecl
DIRS    = src

PWD  = $(shell pwd)
OBJ  = obj
LIB  = lib
AR   = ar
RANLIB = ranlib

all debug:
	@for I in $(DIRS); do cd $(PWD)/$$I; @MAKE@ -f ../Makefile.each $@ || exit 1; cd $(PWD); done
	-@mkdir -p $(OBJ)
	-@mkdir -p $(LIB)
	-@rm -f $(LIB)/lib$(LIBNAME).a
	$(AR) rc $(LIB)/lib$(LIBNAME).a $(OBJ)/*.o
	$(RANLIB) $(LIB)/lib$(LIBNAME).a

check:
	@CXX@ -std=c++11 -I. -Isrc @CPPFLAGS@ \
	  $(shell pkg-config --cflags cppunit) \
	  -o tests/run_tests \
	  tests/main.cpp tests/string_test.cpp tests/wstring_test.cpp \
	  tests/stack_size_test.cpp tests/stack_size_inst.cpp \
	  src/string.cpp \
	  $(shell pkg-config --libs cppunit)
	./tests/run_tests

clean: cleanup all

cleanup:
	-@rm -f $(OBJ)/*.o
	-@rm -f tests/run_tests
