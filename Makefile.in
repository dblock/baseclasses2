LIBNAME = basecl
DIRS    = string

PWD  = $(shell pwd)
OBJ  = obj
LIB  = @libdir@
AR   = ar
RANLIB = ranlib
prefix      = @prefix@
exec_prefix = @exec_prefix@

all debug:
	@for I in $(DIRS); do cd $(PWD)/$$I; @MAKE@ -f ../Makefile.each $@ || exit 1; cd $(PWD); done
	-@mkdir -p $(OBJ)
	-@rm -f $(LIB)/lib$(LIBNAME).a
	$(AR) rc $(LIB)/lib$(LIBNAME).a $(OBJ)/*.o
	$(RANLIB) $(LIB)/lib$(LIBNAME).a

clean: cleanup all

cleanup:
	-@rm -f $(OBJ)/*.o
